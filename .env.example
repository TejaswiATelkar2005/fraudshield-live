# FraudShield Live - Environment Variables
# Phase 1: Zero cloud setup required (SCORER_MODE=mock)
# Phase 2: Firebase Firestore & Authentication
# Phase 3: Google Cloud Vertex AI, Pub/Sub, Cloud Run, BigQuery

# Scorer Configuration ("mock" or "vertex")
SCORER_MODE=mock

# Port Configuration
PORT=3000

# Optional: Google Cloud Vertex AI Configuration (Phase 1-3 when SCORER_MODE=vertex)
VERTEX_PROJECT_ID=
VERTEX_LOCATION=us-central1
VERTEX_ENDPOINT_ID=
VERTEX_AUTH_TOKEN=

# Optional: Google Cloud Pub/Sub & BigQuery (Phase 3)
GCP_PUBSUB_TOPIC=banking-transactions
GCP_BIGQUERY_DATASET=banking_fraud_audit
GCP_BIGQUERY_TABLE=scored_transactions

# Optional: Firebase Auth & Firestore (Phase 2)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
